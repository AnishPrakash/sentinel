# =============================================================================
# SENTINEL — AI-Powered Cyber Threat Intelligence
# PS28 | VITISH 2026 | Smart India Hackathon
#
# Copy this file to .env and fill in the values before running the backend.
# Never commit .env to version control (it is already in .gitignore).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# RISK SCORE WEIGHTS
# Composite formula: α×confidence + β×asset_criticality + γ×blast_radius − δ×disruption_cost
# All four weights should sum to 1.0
# ─────────────────────────────────────────────────────────────────────────────
ALPHA=0.4
BETA=0.3
GAMMA=0.2
DELTA=0.1


# ─────────────────────────────────────────────────────────────────────────────
# GNN / RGCN SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
GNN_THRESHOLD=0.65
MODEL_WEIGHTS=layer2_gnn/weights/rgcn_sentinel.pt


# ─────────────────────────────────────────────────────────────────────────────
# LLM SETTINGS (Ollama — local, no API key needed)
# Use http://localhost:11434 when running outside Docker
# Use http://ollama:11434 when running inside Docker Compose
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1


# ─────────────────────────────────────────────────────────────────────────────
# RAG / VECTOR STORE SETTINGS (ChromaDB)
# Set CHROMA_PATH=http://chromadb:8000 when using the Dockerised service
# ─────────────────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
MITRE_JSON=./data/enterprise-attack.json
TOP_K=5


# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE
# Set to true to serve pre-generated narrative cache instead of live Ollama
# inference. Keep true on hackathon demo day to avoid timeout risk.
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_CACHE=./data/demo_cache


# ─────────────────────────────────────────────────────────────────────────────
# NETWORK TOPOLOGY & ASSET DATA
# ─────────────────────────────────────────────────────────────────────────────
TOPOLOGY_JSON=./data/topology.json
ASSET_JSON=./data/asset_criticality.json
PLAYBOOK_DIR=./data/playbooks


# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES
# ─────────────────────────────────────────────────────────────────────────────
BETH_CSV=./data/beth_dataset.csv


# ─────────────────────────────────────────────────────────────────────────────
# NEO4J — PROVENANCE GRAPH DATABASE (optional)
# Set USE_NEO4J=false to use in-memory NetworkX instead (recommended on low RAM)
# ─────────────────────────────────────────────────────────────────────────────
USE_NEO4J=true
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinel_pass


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite) — place these in frontend/.env, not here
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000
# VITE_GRAPH_POLL_MS=3000
# VITE_ALERTS_POLL_MS=5000